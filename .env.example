# Copy to .env.local and fill in. Values come from Supabase Dashboard → Project Settings.

# --- Supabase (required) ---
# Project URL (API settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server only (required for admin user management) ---
# Service role key — NEVER expose to the client. Used by lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Drizzle Kit (optional: studio / introspect) ---
# Direct Postgres URI, port 5432 (Dashboard → Database → Connection string)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Web Push (notificaciones con la app cerrada) ---
# Generar con: npx web-push generate-vapid-keys
# La pública va al navegador; la privada SOLO en el servidor. Las 3 son necesarias para enviar push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:soporte@example.com
